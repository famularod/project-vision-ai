# Explicit repository-root upload allowlist; no .gitignore include, source PDFs,
# .env/secrets, node_modules, caches, build output, fixtures or device state.
**
!supabase/
!supabase/functions/
!supabase/functions/_shared/
!supabase/functions/_shared/*.ts
!workers/
!workers/ecos-query-runtime/
