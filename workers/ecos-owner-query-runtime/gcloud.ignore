!workers/ecos-owner-query-runtime/.dockerignore
!workers/ecos-owner-query-runtime/cloudbuild.yaml
!workers/ecos-owner-query-runtime/gcloud.ignore
!workers/ecos-owner-query-runtime/main.ts
**/*.test.ts
**/*fixture*.ts
