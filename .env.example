EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Local/internal development only. Enables anon-client Supabase Auth sign-up
# from the photo-intelligence sign-in sheet. Keep unset/false for production.
EXPO_PUBLIC_ENABLE_DEV_AUTH_SIGNUP=false

# Server-side or local-test only. Never expose this with an EXPO_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_URL=

# Vision provider secrets are set only in Supabase Edge Function secrets,
# not in local or client-readable env files.
