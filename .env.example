EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Web-only Google Drive document linking. These values identify the public
# browser integration; never place a Google client secret in the app.
# Restrict the API key to the Google Picker API and approved web origins.
EXPO_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_DRIVE_API_KEY=
EXPO_PUBLIC_GOOGLE_DRIVE_APP_ID=

# Local/internal development only. Enables anon-client Supabase Auth sign-up
# from the photo-intelligence sign-in sheet. Keep unset/false for production.
EXPO_PUBLIC_ENABLE_DEV_AUTH_SIGNUP=false

# Server-side or local-test only. Never expose this with an EXPO_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_PROJECT_REF=
ECOS_SERVICE_WORKER_TOKEN=

# Hosted ECOS worker operations. These belong in Vitruvius-managed Cloud
# Secret Manager or worker configuration, never in a customer app build.
ECOS_WORKER_RUN_MODE=batch
ECOS_WORKER_LEASE_SECONDS=1800
ECOS_MAX_JOBS_PER_RUN=8
ECOS_MAX_RUN_SECONDS=3300
ECOS_MAX_SOURCE_BYTES=262144000
ECOS_MAX_SOURCE_PAGES=500
ECOS_MAX_OCR_TILES_PER_PAGE=128
ECOS_PAGE_TIMEOUT_SECONDS=600
ECOS_REQUIRE_MALWARE_SCAN=true
ECOS_VISUAL_ESTIMATED_COST_MICROUSD=500

# One of these authentication methods is required only while running the
# production Ask ECOS acceptance test. Do not commit real credentials.
ECOS_LIVE_ACCESS_TOKEN=
ECOS_LIVE_TEST_EMAIL=
ECOS_LIVE_TEST_PASSWORD=
ECOS_LIVE_CASE_DELAY_MS=1500

# Vision provider secrets are set only in Supabase Edge Function secrets,
# not in local or client-readable env files.
# ECOS_OPENAI_API_KEY is an optional dedicated server-side key for drawing
# indexing and Ask ECOS. When absent, ECOS uses PIE_OPENAI_API_KEY.
# ECOS_GEMINI_API_KEY enables the bounded Gemini drawing-vision comparison.
# Never prefix it with EXPO_PUBLIC_. The comparison request cannot change the
# production drawing index; a provider is promoted separately after acceptance.
# ECOS_DRAWING_VISION_PROVIDER=openai remains the safe production default.
# ECOS_GEMINI_DRAWING_MODEL=gemini-3.6-flash may be set as a server-side secret
# when a different approved Gemini model is evaluated.
# ECOS_GEMINI_DRAWING_FALLBACK_MODEL=gemini-3.5-flash uses a separate Gemini
# model limit when the primary drawing model returns a temporary 429.
# ECOS_GEMINI_DRAWING_THINKING_LEVEL=MEDIUM controls the Gemini analysis pass only;
# ECOS Assurance always uses the lowest thinking level supported by the model.
# ECOS_DRAWING_ASSURANCE_PROVIDER=openai keeps verification independent when
# Gemini extracts drawing facts. ECOS_DRAWING_ASSURANCE_MODEL may select a
# dedicated server-side OpenAI verification model; it defaults to the approved
# OpenAI drawing model when omitted.
# ECOS_DRAWING_CAPACITY_FALLBACK_PROVIDER=openai lets production indexing use
# the existing OpenAI vision path only when both Gemini model attempts return 429.
# Set it to disabled to turn off this bounded capacity fallback.
