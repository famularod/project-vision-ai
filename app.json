{
  "expo": {
    "name": "Vitruvius",
    "slug": "project-photo-update-tool",
    "version": "1.0.111",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon-vitruvius.png",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.davidfamularo.projectphotoupdate",
      "buildNumber": "111",
      "icon": "./assets/icon-vitruvius.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Vitruvius to capture project photos as field evidence.",
        "NSPhotoLibraryUsageDescription": "Allow Vitruvius to select project photos and supporting evidence from your photo library.",
        "NSPhotoLibraryAddUsageDescription": "Allow Vitruvius to save captured project photos to your photo library when requested.",
        "NSContactsUsageDescription": "Allow Vitruvius to choose update recipients from your contacts.",
        "NSLocationWhenInUseUsageDescription": "This app uses your location to tag project photos and suggest the correct work area.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.davidfamularo.projectphotoupdate",
      "versionCode": 111,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-vitruvius.png",
        "backgroundColor": "#19466F"
      },
      "permissions": [
        "READ_CONTACTS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.WRITE_CONTACTS",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false
    },
    "plugins": [
      "./plugins/withDaveIosAppIcon",
      "@react-native-community/datetimepicker",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "This app uses your location to tag project photos and suggest the correct work area."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Vitruvius to record project memories.",
          "enableBackgroundRecording": false
        }
      ],
      "expo-secure-store",
      "./plugins/withVitruviusAndroidSecurityPolicy",
      "expo-router"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon-vitruvius.png"
    },
    "extra": {
      "buildLabel": "Build 111",
      "productName": "Vitruvius",
      "productMonogram": "V",
      "productSubtitle": "Project Intelligence",
      "eas": {
        "projectId": "38a9bd56-2943-4538-a9bf-1ac6818a3723"
      }
    }
  }
}
