!workers/ecos-indexer/Dockerfile.owner-preview
!workers/ecos-indexer/Dockerfile.owner-preview.dockerignore
!workers/ecos-indexer/gcloud.owner-preview.ignore
!workers/ecos-indexer/requirements.txt
!workers/ecos-indexer/clamav-databases.sha256
!workers/ecos-indexer/ecos-clamd.conf
!workers/ecos-indexer/owner-entrypoint.sh
!workers/ecos-indexer/ecos_indexer/
!workers/ecos-indexer/ecos_indexer/*.py
