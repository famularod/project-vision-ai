{
  "version": "2026.07.02",
  "purpose": "Validation dataset for PIE raw-photo intelligence safeguards. These scenarios assert what photo evidence can and cannot claim.",
  "scenarios": [
    {
      "id": "visible-progress-with-limitations",
      "evidenceType": "photo",
      "expectedOutcome": "supported_with_limitations",
      "mustInclude": ["observations", "limitations", "visualFindings"],
      "mustNotClaim": ["hidden work", "code compliance", "inspection pass", "exact progress percentage"]
    },
    {
      "id": "hidden-condition-rejected",
      "evidenceType": "photo",
      "expectedOutcome": "blocked",
      "unsafeClaim": "inside the conduit is complete",
      "mustReject": true
    },
    {
      "id": "comparison-not-comparable",
      "evidenceType": "photo",
      "expectedOutcome": "blocked",
      "comparability": "not_comparable",
      "mustRejectChangeInference": true
    },
    {
      "id": "project-boundary-mismatch",
      "evidenceType": "photo",
      "expectedOutcome": "blocked",
      "mustReject": "child project differs from parent project"
    },
    {
      "id": "user-correction-preserved",
      "evidenceType": "photo",
      "expectedOutcome": "human_correction_recorded",
      "mustPreserveOriginalAnalysis": true
    },
    {
      "id": "object_added_generic",
      "evidenceType": "photo_comparison",
      "expectedStructuredOutput": {
        "comparabilityClassification": "probable",
        "objectAdditions": [{"object": "newly visible object", "location": "visible work area", "confidence": "medium"}],
        "conclusion": "unable_to_determine",
        "limitations": ["Visible object addition requires project-scope corroboration."]
      }
    },
    {
      "id": "object_removed_generic",
      "evidenceType": "photo_comparison",
      "expectedStructuredOutput": {
        "comparabilityClassification": "probable",
        "objectRemovals": [{"object": "previously visible object", "location": "visible work area", "confidence": "medium"}],
        "conclusion": "unable_to_determine",
        "limitations": ["Removal is visible but cause and project meaning are not proven."]
      }
    },
    {
      "id": "no_visible_change",
      "evidenceType": "photo_comparison",
      "expectedStructuredOutput": {
        "comparabilityClassification": "strong",
        "objectAdditions": [],
        "objectRemovals": [],
        "materialOrStructuralChanges": [],
        "conclusion": "no_material_visible_change",
        "limitations": ["Work may have occurred outside the photographed area."]
      }
    },
    {
      "id": "lighting_only_change",
      "evidenceType": "photo_comparison",
      "expectedStructuredOutput": {
        "comparabilityClassification": "probable",
        "lightingDifferences": ["Lighting changed between photos."],
        "materialOrStructuralChanges": [],
        "conclusion": "unable_to_determine",
        "limitations": ["Lighting change must not be interpreted as progress."]
      }
    },
    {
      "id": "viewpoint_only_change",
      "evidenceType": "photo_comparison",
      "expectedStructuredOutput": {
        "comparabilityClassification": "weak",
        "viewpointAssessment": "Viewpoint changed materially.",
        "conclusion": "unable_to_determine",
        "repeatPhotoGuidance": ["Retake from the prior viewpoint before judging progress."]
      }
    },
    {
      "id": "obstruction_present",
      "evidenceType": "photo",
      "expectedStructuredOutput": {
        "imageQuality": {"obstruction": "low"},
        "directObservations": ["A visible obstruction limits evaluation."],
        "confidence": "low",
        "recommendedFollowUpEvidence": ["Retake the photo without the obstruction."]
      }
    },
    {
      "id": "blurred_image",
      "evidenceType": "photo",
      "expectedStructuredOutput": {
        "imageQuality": {"focus": "low"},
        "confidence": "low",
        "limitations": ["Blur prevents reliable visual analysis."],
        "recommendedFollowUpEvidence": ["Capture a sharper image."]
      }
    },
    {
      "id": "different_subject",
      "evidenceType": "photo_comparison",
      "expectedStructuredOutput": {
        "comparabilityClassification": "not_comparable",
        "sameSubjectProbability": 0,
        "conclusion": "unable_to_determine",
        "limitations": ["Photos show different subjects."]
      }
    },
    {
      "id": "different_project",
      "evidenceType": "photo_comparison",
      "expectedOutcome": "blocked",
      "expectedStructuredOutput": {
        "jarvisRejectedClaims": ["cross-project comparison rejected"],
        "conclusion": "unable_to_determine"
      }
    },
    {
      "id": "partial_visible_progress",
      "evidenceType": "photo_comparison",
      "expectedStructuredOutput": {
        "comparabilityClassification": "strong",
        "materialOrStructuralChanges": ["A scope-linked element appears partially installed."],
        "conclusion": "partial_progress_visible",
        "limitations": ["Visible progress requires scope and inspection corroboration."]
      }
    },
    {
      "id": "possible_regression",
      "evidenceType": "photo_comparison",
      "expectedStructuredOutput": {
        "comparabilityClassification": "strong",
        "possibleRegression": ["A previously visible condition appears removed or degraded."],
        "conclusion": "possible_regression",
        "limitations": ["Regression requires human review before action."]
      }
    },
    {
      "id": "photo_contradicts_written_status",
      "evidenceType": "photo_comparison",
      "expectedStructuredOutput": {
        "comparabilityClassification": "probable",
        "visibleConcerns": ["Visible condition may conflict with written complete status."],
        "conclusion": "unable_to_determine",
        "limitations": ["Written status may be stronger or newer evidence."]
      }
    },
    {
      "id": "photo_corroborates_written_status",
      "evidenceType": "photo_comparison",
      "expectedStructuredOutput": {
        "comparabilityClassification": "strong",
        "unchangedConditions": ["Visible condition aligns with written status."],
        "conclusion": "progress_visible",
        "limitations": ["Photo corroborates visible scope only."]
      }
    },
    {
      "id": "canopy_c_cross_angle_concrete_ramp",
      "caseName": "Canopy C cross-angle ramp comparison",
      "evidenceType": "photo_comparison",
      "description": "Two field photos show the same Canopy C ramp area from different angles. Stable canopy columns, slab edges, and building geometry establish scene continuity. The newer photo shows concrete ramp work that is absent from the earlier photo.",
      "requiredLiveFixture": true,
      "expected": {
        "comparability": "probable",
        "sameGeneralScene": true,
        "materialVisibleChange": true,
        "changeType": "object_added",
        "addedObject": "concrete ramp",
        "progressConclusion": "partial_progress_visible",
        "confidence": "medium_or_higher",
        "maximumLatencyMs": 60000
      }
    },
    {
