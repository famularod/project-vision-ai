    {
      "id": "north-lot-pcc-design-thickness",
      "question": "What thickness does the current drawing specify for the new PCC paving in the 2375 North Lot?",
      "expectedAnswer": "The current civil drawing, Sheet C6, specifies 6.0 inches of PCC paving at the 2375 North Lot.",
      "requiredAnswerPatterns": ["\\b6(?:\\.0)?\\s*-?\\s*(?:(?:inch(?:es)?|in\\.?)\\b|[\\\"”])", "\\bPCC\\b", "\\b(?:drawing|design|specif(?:y|ies|ied))\\b"],
      "forbiddenAnswerPatterns": ["\\b4\\s*-?\\s*(?:(?:inch(?:es)?|in\\.?)\\b|[\\\"”])"],
      "allowedAssuranceStatuses": ["verified", "verified_with_limits"],
      "minimumDocumentCitations": 1,
      "minimumDistinctDocuments": 1,
      "minimumDistinctSheets": 1,
      "expectedEvidence": [
        {
          "documentNamePattern": "02A.*2375.*CIVIL",
          "sheetNumberPatterns": ["^C6$"],
          "excerptPatterns": ["6(?:\\.0)?\\s*[\\\"”]?\\s*THICK\\s+PCC\\s+PAVING"],
          "requireBoundedRegion": true,
          "requireHighResolutionCoverage": true
        }
      ]
    },
